<Window x:Class="Day16.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кинотеатр - Система бронирования"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <StackPanel>
                    <TextBlock Text="КИНОТЕАТР" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Система онлайн бронирования билетов" Foreground="White" Opacity="0.8"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Background="#1565C0" CornerRadius="15" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock x:Name="UserNameText" Foreground="White" FontSize="12"/>
                    </Border>
                    <Button x:Name="LogoutButton" Content="Выход" Background="#F44336" Foreground="White" 
                            Padding="8,4" FontSize="11" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Фильмы -->
            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White">
                <StackPanel>
                    <Border Background="#F5F5F5" Padding="10" CornerRadius="5,5,0,0">
                        <StackPanel>
                            <TextBlock Text="Фильмы" FontWeight="Bold" FontSize="14"/>
                            <Button x:Name="RefreshMoviesButton" Content="Обновить" Margin="0,5,0,0" Height="30"/>
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="MoviesListBox" BorderThickness="0" Margin="5" Height="500">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" 
                                        Margin="5" Padding="10" Background="White">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding Time}" Foreground="#666" FontSize="11" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Genre}" Foreground="#999" FontSize="10"/>
                                        <TextBlock Text="{Binding Duration}" Foreground="#999" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="5" Background="#DDD"/>

            <!-- Схема зала -->
            <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White">
                <StackPanel>
                    <Border Background="#F5F5F5" Padding="10" CornerRadius="5,5,0,0">
                        <TextBlock Text="Схема зала" FontWeight="Bold" FontSize="14"/>
                    </Border>
                    <ScrollViewer x:Name="SeatsScrollViewer" VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Auto" Margin="10" Height="500"/>
                    <Border Background="#F9F9F9" Padding="10" Margin="10,5,10,10" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="ЭКРАН" FontSize="10" Foreground="#999" HorizontalAlignment="Center"/>
                            <Rectangle Height="2" Fill="#CCC" Margin="0,3,0,5"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <Border Width="20" Height="20" Background="#4CAF50" CornerRadius="3" Margin="0,0,5,0"/>
                                    <TextBlock Text="Свободно" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <Border Width="20" Height="20" Background="#F44336" CornerRadius="3" Margin="0,0,5,0"/>
                                    <TextBlock Text="Занято" FontSize="11"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="5" Background="#DDD"/>

            <!-- Бронирования -->
            <Border Grid.Column="4" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White">
                <StackPanel>
                    <Border Background="#F5F5F5" Padding="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Мои бронирования" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <Button x:Name="RefreshBookingsButton" Content="⟳" Width="30" Height="25" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="BookingsListBox" BorderThickness="0" Margin="5" Height="400" DisplayMemberPath="DisplayText"/>
                    <Button x:Name="CancelBookingButton" Content="✖ Отменить бронь" Background="#F44336" 
                            Foreground="White" Margin="10" Padding="10" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#F5F5F5" CornerRadius="5" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#666"/>
                <ProgressBar x:Name="LoadingProgressBar" Grid.Column="1" Width="100" Height="15" 
                             Visibility="Collapsed" IsIndeterminate="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>