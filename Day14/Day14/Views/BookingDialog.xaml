<Window x:Class="Day14.Views.BookingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Бронирование билетов"
        Height="450" Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="120"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<TextBlock Grid.Row="0" Grid.Column="0" Text="ФИО клиента:"
                   VerticalAlignment="Center" Margin="0,5"/>
		<TextBox x:Name="CustomerNameBox" Grid.Row="0" Grid.Column="1"
                 Height="30" Margin="0,5" Padding="5"
                 VerticalContentAlignment="Center"/>

		<TextBlock Grid.Row="1" Grid.Column="0" Text="Телефон:"
                   VerticalAlignment="Center" Margin="0,5"/>
		<TextBox x:Name="PhoneBox" Grid.Row="1" Grid.Column="1"
                 Height="30" Margin="0,5" Padding="5"
                 VerticalContentAlignment="Center"/>

		<TextBlock Grid.Row="2" Grid.Column="0" Text="Фильм:"
                   VerticalAlignment="Center" Margin="0,5"/>
		<TextBlock Grid.Row="2" Grid.Column="1"
                   Text="{Binding Title}"
                   VerticalAlignment="Center" Margin="0,5" FontWeight="Bold"
                   FontSize="14"/>

		<TextBlock Grid.Row="3" Grid.Column="0" Text="Время сеанса:"
                   VerticalAlignment="Center" Margin="0,5"/>
		<TextBlock Grid.Row="3" Grid.Column="1"
                   Text="{Binding Time}"
                   VerticalAlignment="Center" Margin="0,5"/>

		<TextBlock Grid.Row="4" Grid.Column="0" Text="Цена билета:"
                   VerticalAlignment="Center" Margin="0,5"/>
		<TextBlock Grid.Row="4" Grid.Column="1"
                   Text="{Binding Price}"
                   VerticalAlignment="Center" Margin="0,5"/>

		<TextBlock Grid.Row="5" Grid.Column="0" Text="Количество билетов:"
                   VerticalAlignment="Center" Margin="0,5"/>
		<StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
			<Button Content="-" Width="30" Height="30" Click="DecrementTickets"/>
			<TextBox x:Name="TicketsBox" Text="{Binding SelectedTickets, UpdateSourceTrigger=PropertyChanged}"
                     Width="60" Height="30" TextAlignment="Center" Margin="5,0"
                     PreviewTextInput="NumberValidationTextBox"/>
			<Button Content="+" Width="30" Height="30" Click="IncrementTickets"/>
			<TextBlock Text="мест" VerticalAlignment="Center" Margin="10,0,0,0"/>
		</StackPanel>

		<Border Grid.Row="7" Grid.ColumnSpan="2" Background="#F0F0F0"
                CornerRadius="5" Margin="0,15,0,0" Padding="10">
			<StackPanel>
				<TextBlock Text="Итого к оплате:" FontWeight="SemiBold"/>
				<TextBlock Name="TotalPriceText"
                           Text="{Binding TotalPrice, StringFormat={}{0} руб.}"
                           FontSize="18" FontWeight="Bold" Foreground="Green"/>
			</StackPanel>
		</Border>

		<StackPanel Grid.Row="8" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,15,0,0">
			<Button x:Name="BookButton" Content="Забронировать"
                    Width="120" Height="35" Margin="5,0"
                    Click="Ok_Click" IsDefault="True">
				<Button.Template>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="0"
                                Padding="10,5">
							<ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#4CAF50"/>
								<Setter Property="Cursor" Value="Hand"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter Property="Background" Value="#388E3C"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Button.Template>
			</Button>
			<Button Content="Отмена" Width="120" Height="35" Margin="5,0"
                    IsCancel="True" Click="Cancel_Click">
				<Button.Template>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderThickness="0"
                                Padding="10,5">
							<ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#F44336"/>
								<Setter Property="Cursor" Value="Hand"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Button.Template>
			</Button>
		</StackPanel>
	</Grid>
</Window>