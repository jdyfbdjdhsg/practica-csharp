<Window x:Class="Day14.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Day14.Models"
        xmlns:viewmodels="clr-namespace:Day14.ViewModels"
        Title="Бронирование билетов в кинотеатр"
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate x:Key="MovieCardTemplate" DataType="models:MovieSession">
            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" 
                    Margin="5" Padding="10" Background="White">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="{Binding Time}" Foreground="#666" Margin="0,5,0,0"/>
                    <TextBlock Foreground="Green" Margin="0,5,0,0">
                        <Run Text="{Binding Price}"/>
                        <Run Text=" руб."/>
                    </TextBlock>
                    <TextBlock Foreground="#999" FontSize="11" TextAlignment="Center">
                        <Run Text="Свободно: "/>
                        <Run Text="{Binding AvailableSeats}"/>
                        <Run Text=" мест"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <ControlTemplate x:Key="BuyTicketButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}" 
                    CornerRadius="20" 
                    BorderThickness="0"
                    Padding="15,8">
                <StackPanel Orientation="Horizontal">
                    <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2196F3"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="CancelButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}" 
                    CornerRadius="20" 
                    BorderThickness="0"
                    Padding="15,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✖ " FontSize="14"/>
                    <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F44336"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2196F3" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="КИНОТЕАТР" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Онлайн бронирование билетов" Foreground="White" Opacity="0.8"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White">
                <StackPanel>
                    <Border Background="#F5F5F5" Padding="10" CornerRadius="5,5,0,0">
                        <StackPanel>
                            <TextBlock Text="Доступные фильмы" FontWeight="Bold"/>
                            <ComboBox ItemsSource="{Binding FilterOptions}" 
                                      SelectedItem="{Binding SelectedFilter}"
                                      Margin="0,5,0,0"
                                      Width="150"/>
                        </StackPanel>
                    </Border>
                    <ListBox ItemsSource="{Binding FilteredSessions}"
                             SelectedItem="{Binding SelectedSession}"
                             ItemTemplate="{StaticResource MovieCardTemplate}"
                             BorderThickness="0"
                             Margin="5"
                             Height="400"/>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="5"/>

            <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White">
                <StackPanel>
                    <Border Background="#F5F5F5" Padding="10" CornerRadius="5,5,0,0">
                        <TextBlock Text="Мои бронирования" FontWeight="Bold"/>
                    </Border>
                    <ListBox ItemsSource="{Binding Bookings}"
                             SelectedItem="{Binding SelectedBooking}"
                             DisplayMemberPath="DisplayText"
                             BorderThickness="0"
                             Margin="5"
                             MinHeight="200"
                             Height="400"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="Купить билет" 
                    Command="{Binding BookTicketCommand}"
                    Template="{StaticResource BuyTicketButtonTemplate}"
                    Background="#4CAF50" Foreground="White"
                    FontWeight="SemiBold"
                    Height="40"
                    Margin="10,0"/>

            <Button Content="Отменить бронь" 
                    Command="{Binding CancelBookingCommand}"
                    Template="{StaticResource CancelButtonTemplate}"
                    Background="#9E9E9E" Foreground="White"
                    FontWeight="SemiBold"
                    Height="40"
                    Margin="10,0"/>
        </StackPanel>
    </Grid>
</Window>