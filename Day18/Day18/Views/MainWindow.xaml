<Window x:Class="Day18.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кинотеатр - Система бронирования"
        Height="750" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#FFF0F0F0">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
                <StackPanel>
                    <TextBlock Text="КИНОТЕАТР" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Система онлайн бронирования билетов" Foreground="White" Opacity="0.8"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Background="#1565C0" CornerRadius="15" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock x:Name="UserNameText" Foreground="White" FontSize="12"/>
                    </Border>
                    <Button x:Name="LogoutButton" Content="Выход" Background="#F44336" Foreground="White" Padding="12,6" FontSize="11" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Фильмы -->
            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Background="White">
                <StackPanel>
                    <Border Background="#F5F5F5" Padding="12" CornerRadius="8,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Фильмы" FontWeight="Bold" FontSize="14"/>
                            <Button x:Name="RefreshMoviesButton" Content="Обновить" Margin="0,5,0,0" Height="30" Background="#E0E0E0" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="500">
                        <ListBox x:Name="MoviesListBox" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="5,8,5,20" Padding="20" Cursor="Hand">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="{Binding Time}" Foreground="#666" FontSize="11" Margin="0,2,0,0"/>
                                            <WrapPanel Margin="0,5,0,0">
                                                <Border Background="{Binding PosterColor}" CornerRadius="10" Padding="8,2">
                                                    <TextBlock Text="{Binding Genre}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text=" | " Foreground="#CCC" Margin="5,0"/>
                                                <TextBlock Text="{Binding Duration}" Foreground="#999" FontSize="10"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="5" Background="#DDD"/>

            <!-- Схема зала -->
            <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Background="White">
                <StackPanel>
                    <Border Background="#F5F5F5" Padding="12" CornerRadius="8,8,0,0">
                        <TextBlock Text="Схема зала" FontWeight="Bold" FontSize="14"/>
                    </Border>
                    <ScrollViewer x:Name="SeatsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="10" Height="500">
                        <Border x:Name="SeatsContainer" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform/>
                            </Border.RenderTransform>
                            <StackPanel x:Name="SeatsPanel"/>
                        </Border>
                    </ScrollViewer>
                    <Border Background="#F9F9F9" Padding="10" Margin="10,5,10,10" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="ЭКРАН" FontSize="10" Foreground="#999" HorizontalAlignment="Center"/>
                            <Rectangle Height="3" Fill="#CCC" Margin="0,5,0,8" RadiusX="2" RadiusY="2"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="15,0">
                                    <Border Width="24" Height="24" Background="#4CAF50" CornerRadius="6" Margin="0,0,8,0"/>
                                    <TextBlock Text="Свободно" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="15,0">
                                    <Border Width="24" Height="24" Background="#F44336" CornerRadius="6" Margin="0,0,8,0"/>
                                    <TextBlock Text="Занято" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="5" Background="#DDD"/>

            <!-- Правая панель: ДВЕ ВКЛАДКИ - старые бронирования + вариант 9 -->
            <Border Grid.Column="4" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Background="White">
                <TabControl>
                    <!-- Вкладка 1: Старые бронирования -->
                    <TabItem Header="Мои бронирования">
                        <StackPanel Margin="10">
                            <Button x:Name="RefreshBookingsButton" Content="Обновить бронирования" Margin="0,5" Height="30" Background="#E0E0E0" Cursor="Hand"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="420">
                                <ListBox x:Name="BookingsListBox" BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F9F9F9" CornerRadius="6" Margin="5" Padding="10" BorderBrush="#E0E0E0" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding MovieTitle}" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="{Binding SeatNumber}" Foreground="#666" FontSize="11" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding Price}" Foreground="#2196F3" FontWeight="Bold" FontSize="12" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding BookingTime}" Foreground="#999" FontSize="10"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                            <Button x:Name="CancelBookingButton" Content="Отменить бронь" Background="#F44336" Foreground="White" FontSize="13" Cursor="Hand" Height="40" Margin="0,10,0,0"/>
                        </StackPanel>
                    </TabItem>

                    <!-- Вкладка 2: Вариант 9 - Бронирование билетов -->
                    <TabItem Header="Бронирование билетов">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">

                                <!-- Sessions привязаны к ComboBox (ПО ТЗ) -->
                                <TextBlock Text="Выберите сеанс:" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="SessionsComboBox" 
                                          ItemsSource="{Binding Sessions}" 
                                          DisplayMemberPath="DisplayText"
                                          SelectedItem="{Binding SelectedSession}"
                                          Height="35" 
                                          Margin="0,0,0,15"
                                          FontSize="12"/>

                                <!-- Форма бронирования -->
                                <Border Background="#F9F9F9" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="Данные бронирования" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>

                                        <TextBlock Text="Номер места:" FontSize="11" Foreground="#666"/>
                                        <TextBox Text="{Binding SelectedSeat, UpdateSourceTrigger=PropertyChanged}" 
                                                 Margin="0,5,0,12"
                                                 Height="35"
                                                 FontSize="12"
                                                 Padding="8"/>

                                        <TextBlock Text="Ваше имя:" FontSize="11" Foreground="#666"/>
                                        <TextBox Text="{Binding CustomerName}" 
                                                 Margin="0,5,0,12"
                                                 Height="35"
                                                 FontSize="12"
                                                 Padding="8"/>

                                        <TextBlock Text="Телефон:" FontSize="11" Foreground="#666"/>
                                        <TextBox Text="{Binding PhoneNumber}" 
                                                 Margin="0,5,0,12"
                                                 Height="35"
                                                 FontSize="12"
                                                 Padding="8"/>

                                        <Button Content="ЗАБРОНИРОВАТЬ БИЛЕТ" 
                                                Command="{Binding BookTicketCommand}"
                                                Background="#4CAF50"
                                                Foreground="White"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Height="35"
                                                Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Tickets привязаны к ListBox (ПО ТЗ) -->
                                <TextBlock Text="Мои билеты:" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ListBox x:Name="TicketsListBox" 
                                         ItemsSource="{Binding Tickets}" 
                                         SelectedItem="{Binding SelectedTicket}"
                                         Height="200"
                                         Margin="0,0,0,10"
                                         BorderBrush="#E0E0E0"
                                         BorderThickness="1">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F5F5F5" CornerRadius="4" Margin="3" Padding="8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding MovieTitle}" FontWeight="Bold" FontSize="12"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Место: " Foreground="#666" FontSize="10"/>
                                                        <TextBlock Text="{Binding SeatNumber}" Foreground="#666" FontSize="10"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Price}" Foreground="#4CAF50" FontSize="11" FontWeight="Bold"/>
                                                        <TextBlock Text=" руб." Foreground="#4CAF50" FontSize="11" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Кнопки управления -->
                                <Button Content="ОТМЕНИТЬ ВЫБРАННЫЙ БИЛЕТ" 
                                        Command="{Binding CancelTicketCommand}"
                                        Background="#F44336"
                                        Foreground="White"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Height="35"
                                        Margin="0,5,0,10"/>

                                <Button Content="ОБНОВИТЬ СЕАНСЫ" 
                                        Command="{Binding LoadSessionsCommand}"
                                        Background="#9E9E9E"
                                        Foreground="White"
                                        FontSize="11"
                                        Height="30"
                                        Margin="0,5,0,5"/>

                                <Button Content="ОБНОВИТЬ МОИ БИЛЕТЫ" 
                                        Command="{Binding LoadTicketsCommand}"
                                        Background="#9E9E9E"
                                        Foreground="White"
                                        FontSize="11"
                                        Height="30"
                                        Margin="0,0,0,10"/>

                                <!-- Статус -->
                                <Border Background="#FFF3E0" CornerRadius="6" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="СТАТУС" FontWeight="Bold" FontSize="10" Foreground="#E65100"/>
                                        <TextBlock Text="{Binding StatusMessage}" Foreground="#666" FontSize="10" TextWrapping="Wrap"/>
                                        <ProgressBar IsIndeterminate="{Binding IsLoading}" Height="2" Margin="0,5,0,0"
                                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#F5F5F5" CornerRadius="5" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#666"/>
                <ProgressBar x:Name="LoadingProgressBar" Grid.Column="1" Width="120" Height="15" Visibility="Collapsed" IsIndeterminate="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>