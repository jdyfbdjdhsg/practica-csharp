<Window x:Class="Day18.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кинотеатр - Вход"
        Height="530" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFF5F5F5">

    <!-- УБЕРИТЕ ЭТОТ БЛОК, если ошибка -->
    <!--
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource WindowFadeIn}"/>
        </EventTrigger>
    </Window.Triggers>
    -->

    <Grid>
        <Border Background="#2196F3" Height="513" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="КИНОТЕАТР" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Система бронирования билетов" FontSize="12" Foreground="White" Opacity="0.8"/>
            </StackPanel>
        </Border>

        <Border Margin="15,0,15,0" Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Center">
            <StackPanel>
                <StackPanel x:Name="LoginPanel" Visibility="Visible">
                    <TextBlock Text="Вход в аккаунт" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBox x:Name="UsernameBox" Margin="0,5" Padding="10" FontSize="13" Text="admin"/>
                    <PasswordBox x:Name="PasswordBox" Margin="0,5" Padding="10" FontSize="13"/>
                    <TextBlock x:Name="ErrorText" Foreground="#F44336" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <Button x:Name="LoginButton" Content="Войти" Height="45" FontSize="14" FontWeight="Bold" Margin="0,20,0,10" Background="#2196F3" Foreground="White"/>
                    <Button x:Name="ShowRegisterButton" Content="Зарегистрироваться" Height="40" FontSize="13" Margin="0,5,0,0" Background="#4CAF50" Foreground="White"/>
                    <ProgressBar x:Name="ProgressBar" Height="3" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
                    <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Margin="0,20,0,0" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Тестовые данные:" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="Администратор: admin / admin123" FontSize="10" Foreground="#666"/>
                            <TextBlock Text="Пользователь: user / user123" FontSize="10" Foreground="#666"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                    <TextBlock Text="Регистрация" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBox x:Name="RegUsernameBox" Margin="0,5" Padding="10" FontSize="13"/>
                    <TextBox x:Name="RegFullNameBox" Margin="0,5" Padding="10" FontSize="13"/>
                    <TextBox x:Name="RegPhoneBox" Margin="0,5" Padding="10" FontSize="13"/>
                    <PasswordBox x:Name="RegPasswordBox" Margin="0,5" Padding="10" FontSize="13"/>
                    <PasswordBox x:Name="RegConfirmPasswordBox" Margin="0,5" Padding="10" FontSize="13"/>
                    <TextBlock x:Name="RegErrorText" Foreground="#F44336" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <Button x:Name="RegisterButton" Content="Зарегистрироваться" Height="45" FontSize="14" FontWeight="Bold" Margin="0,20,0,10" Background="#4CAF50" Foreground="White"/>
                    <Button x:Name="BackToLoginButton" Content="Назад ко входу" Height="40" FontSize="13" Margin="0,5,0,0" Background="#666" Foreground="White"/>
                    <ProgressBar x:Name="RegProgressBar" Height="3" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>