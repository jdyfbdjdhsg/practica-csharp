<Window x:Class="Day15.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Day15.Views"
        Title="Кинотеатр - Система бронирования билетов"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <views:BoolToColorConverter x:Key="BoolToColorConverter"/>

        <DataTemplate x:Key="MovieCardTemplate">
            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" 
                    Margin="5" Padding="10" Background="White">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="{Binding Time}" Foreground="#666" FontSize="11" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding Genre}" Foreground="#999" FontSize="10"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SeatTemplate">
            <Button Width="45" Height="45" Margin="3"
                    Command="{Binding DataContext.BookSeatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#4CAF50"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="#666" BorderThickness="1" CornerRadius="5">
                                        <TextBlock Text="{Binding SeatNumber}" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   Foreground="White" 
                                                   FontWeight="Bold" 
                                                   FontSize="12"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter Property="Background" Value="#F44336"/>
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2196F3" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="КИНОТЕАТР" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Система онлайн бронирования билетов" Foreground="White" Opacity="0.8"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White">
                <StackPanel>
                    <Border Background="#F5F5F5" Padding="10" CornerRadius="5,5,0,0">
                        <StackPanel>
                            <TextBlock Text="Фильмы" FontWeight="Bold" FontSize="14"/>
                            <Button Content="Обновить" Command="{Binding LoadMoviesCommand}"
                                    Margin="0,5,0,0" Height="30"/>
                        </StackPanel>
                    </Border>

                    <ProgressBar Value="{Binding LoadingProgress}" Height="3" 
                                 Visibility="{Binding IsLoadingMovies, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <ListBox ItemsSource="{Binding Movies}" SelectedItem="{Binding SelectedMovie}"
                             ItemTemplate="{StaticResource MovieCardTemplate}"
                             BorderThickness="0" Margin="5" Height="450"/>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="5"/>

            <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White">
                <StackPanel>
                    <Border Background="#F5F5F5" Padding="10" CornerRadius="5,5,0,0">
                        <TextBlock Text="Схема зала" FontWeight="Bold" FontSize="14"/>
                    </Border>

                    <ProgressBar Value="{Binding LoadingProgress}" Height="3" 
                                 Visibility="{Binding IsLoadingSeats, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="10" Height="450">
                        <ItemsControl ItemsSource="{Binding SeatsGrouped}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5">
                                        <TextBlock Text="{Binding Row}" FontWeight="Bold" 
                                                   HorizontalAlignment="Center" FontSize="14"/>
                                        <ItemsControl ItemsSource="{Binding Seats}" ItemTemplate="{StaticResource SeatTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Background="#F9F9F9" Padding="10" Margin="10,5,10,10" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="ЭКРАН" FontSize="10" Foreground="#999" HorizontalAlignment="Center"/>
                            <Rectangle Height="2" Fill="#CCC" Margin="0,3,0,5"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <Border Width="20" Height="20" Background="#4CAF50" CornerRadius="3" Margin="0,0,5,0"/>
                                    <TextBlock Text="Свободно" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <Border Width="20" Height="20" Background="#F44336" CornerRadius="3" Margin="0,0,5,0"/>
                                    <TextBlock Text="Занято" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="5"/>

            <Border Grid.Column="4" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White">
                <StackPanel>
                    <Border Background="#F5F5F5" Padding="10" CornerRadius="5,5,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Бронирования" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            <Button Content="⟳" Command="{Binding RefreshBookingsCommand}" 
                                    Width="30" Height="25" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <ListBox ItemsSource="{Binding Bookings}" SelectedItem="{Binding SelectedBooking}"
                             DisplayMemberPath="DisplayText"
                             BorderThickness="0" Margin="5" Height="400"/>

                    <Button Content="✖ Отменить бронь" Command="{Binding CancelBookingCommand}"
                            Background="#F44336" Foreground="White" Margin="10" Padding="10" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#F5F5F5" CornerRadius="5" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#666"/>

                <ProgressBar Grid.Column="1" Width="100" Height="20" 
                             Value="{Binding LoadingProgress}"
                             Visibility="{Binding IsBooking, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>