<Window x:Class="CinemaBooking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кинотеатр" Height="550" Width="600"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF6B6B" Offset="0"/>
            <GradientStop Color="#FFE66D" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="КИНОТЕАТР" 
                   FontSize="32" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Foreground="White" 
                   Margin="0,10,0,20"
                   TextAlignment="Center"/>

        <Border Grid.Row="1" Background="White" 
                CornerRadius="10" Margin="20,0,20,10" Padding="15">
            <StackPanel>
                <TextBlock Text="Выберите фильм:" FontSize="16" 
                           FontWeight="Bold" Margin="0,0,0,10"/>
                <ComboBox x:Name="MovieComboBox" FontSize="14" Height="35">
                    <ComboBoxItem Content="Человек-паук: Нет пути домой"/>
                    <ComboBoxItem Content="Аватар 2"/>
                    <ComboBoxItem Content="Оппенгеймер"/>
                    <ComboBoxItem Content="Барби"/>
                    <ComboBoxItem Content="Джон Уик 4"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" 
                CornerRadius="10" Margin="20" Padding="15">
            <StackPanel>
                <TextBlock Text="Схема зала (серые - свободны, красные - заняты, зеленые - выбрано)" 
                           FontSize="12" TextWrapping="Wrap" 
                           TextAlignment="Center" Margin="0,0,0,10"/>

                <!-- Экран -->
                <Border Background="Black" Height="5" 
                        CornerRadius="2" Margin="0,0,0,20"/>
                <TextBlock Text="ЭКРАН" HorizontalAlignment="Center" 
                           FontSize="10" Foreground="Gray" 
                           Margin="0,-5,0,10"/>

                <Grid x:Name="SeatsGrid" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </StackPanel>
        </Border>

        <Button x:Name="BookButton" Grid.Row="3" 
                Content="ЗАБРОНИРОВАТЬ" 
                Click="BookButton_Click"
                FontSize="18" FontWeight="Bold" 
                Height="50" Margin="50,0,50,20"
                Background="#FF6B6B" Foreground="White"
                Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>